\subsection{Quantum Edge Convolution}
\label{sec:quantum_edge}

As illustrated in Figure~\ref{fig:architecture}, let a 3D molecule be represented as a graph $\mathcal{G} = (\mathcal{V}, \mathcal{E}, \mathbf{x}, \mathbf{h})$, where each atom $i \in \mathcal{V}$ has spatial coordinates $\mathbf{x}_i \in \mathbb{R}^3$ and invariant atomic feature vector $\mathbf{h}_i \in \mathbb{R}^{d_{\mathrm{in}}}$. Edges $(i, j) \in \mathcal{E}$ connect interacting atomic pairs within a radius cutoff, defining the neighborhood $\mathcal{N}(i) = \{j : (i, j) \in \mathcal{E}\}$. The squared Euclidean distance is:
\begin{equation}
    d_{ij} = \|\mathbf{x}_i - \mathbf{x}_j\|^2 \in \mathbb{R}_{\ge 0}
\end{equation}

\paragraph{Gaussian RBF Distance Expansion.}
Rather than encoding raw distances via a single scalar weight $w_d^{(l)} \cdot d_{ij}$, we expand distances into a multi-frequency Gaussian radial basis \cite{schütt2017schnetcontinuousfilterconvolutionalneural}:
\begin{equation}
    \phi_k(d_{ij}) = \exp\left(-\gamma_k (d_{ij} - \mu_k)^2\right), \quad k = 1, \ldots, K
    \label{eq:rbf}
\end{equation}
where $\mu_k$ are evenly spaced centers in $[0, 10]$~\AA$^2$ and $\gamma_k$ are learnable inverse widths. Under the Fourier analysis of data re-uploading \cite{Perez-Salinas:2019pjx, Schuld:2020enb}, this transforms the PQC into a truncated $K$-term Fourier approximator for molecular potential surfaces.

Each qubit receives a per-layer, per-qubit weighted phase:
\begin{equation}
    R_z\!\left(\sum_{k=1}^K w_{d,q,k}^{(l)} \cdot \phi_k(d_{ij})\right), \quad q = 0, \ldots, 3
\end{equation}

\paragraph{Multi-Head Design.}
Following multi-head attention designs, we use two parallel PQC heads (\textit{Electronic} and \textit{Topological}). Each head uses an independent feature projection $\mathbf{W}_p^{(s)}: \mathbb{R}^{d_{\mathrm{hidden}}} \to \mathbb{R}^2$ to direct distinct feature subspaces into its respective quantum circuit:
\begin{equation}
    \mathbf{h}_i^{p,(s)} = \mathbf{W}_p^{(s)} \mathbf{h}_i, \quad s \in \{1, 2\}
\end{equation}
Both heads share the same RBF distance features and angular inputs but process them through independent PQC parameter sets.

\paragraph{4-Qubit Parameterized Quantum Circuit.}
For each head $s$ and directed edge $(i, j)$, the combined input vector is:
\begin{equation}
    \mathbf{u}_{ij}^{(s)} = \left[h_{i,0}^{p,(s)}, h_{i,1}^{p,(s)}, h_{j,0}^{p,(s)}, h_{j,1}^{p,(s)}, \boldsymbol{\phi}(d_{ij})^T, \bar{\theta}_{ij}\right]^T
\end{equation}

Across $L$ variational layers, the circuit interleaves:
\begin{enumerate}
    \item \textbf{Multi-Axis Feature Encoding:}
    \begin{equation}
        U_{\mathrm{feat}}(\mathbf{u}_{ij}^{(s)}) = \bigotimes_{q=0}^1 R_y(h_{i,q}^{p,(s)}) \otimes \bigotimes_{q=0}^1 R_y(h_{j,q}^{p,(s)})
    \end{equation}
    \item \textbf{Distance Re-Uploading:}
    \begin{equation}
        U_{\mathrm{dist}}^{(l)} = \bigotimes_{q=0}^3 R_z\!\left(\sum_{k=1}^K w_{d,q,k}^{(l)} \cdot \phi_k(d_{ij})\right)
    \end{equation}
    \item \textbf{Angular Re-Uploading:}
    \begin{equation}
        U_{\mathrm{ang}}(\bar{\theta}_{ij}) = \bigotimes_{q=0}^3 R_y(\bar{\theta}_{ij})
    \end{equation}
    \item \textbf{Single-Qubit Variational Rotations:}
    \begin{equation}
        U_{\mathrm{rot}}(\boldsymbol{\theta}_l) = \bigotimes_{q=0}^3 R_z(\theta_{l,q,2}) R_y(\theta_{l,q,1}) R_x(\theta_{l,q,0})
    \end{equation}
    \item \textbf{Circular Ring CNOT Entanglement:}
    \begin{equation}
        U_{\mathrm{ent}} = \prod_{q=0}^3 \mathrm{CNOT}_{q, (q+1)\bmod 4}
    \end{equation}
\end{enumerate}

\paragraph{3-Body SO(3)-Invariant Angular Encoding.}
For each edge $(i, j)$, we compute the mean bond angle $\bar{\theta}_{ij}$ across all third atoms $k \in \mathcal{N}(i), k \neq j$ via vectorized $O(E)$ operations:
\begin{align}
    \bar{\cos}_{ij} &= \frac{\hat{\mathbf{r}}_{ij} \cdot \sum_{k \in \mathcal{N}(i)} \hat{\mathbf{r}}_{ik} - 1}{\deg(i) - 1}, \label{eq:angle} \\
    \bar{\theta}_{ij} &= \arccos\!\left(\mathrm{clamp}(\bar{\cos}_{ij}, -1, 1)\right) \nonumber
\end{align}
where $\hat{\mathbf{r}}_{ij} = (\mathbf{x}_j - \mathbf{x}_i) / \|\mathbf{x}_j - \mathbf{x}_i\|$. This is strictly $\mathrm{O}(3)$-invariant since $\cos \theta_{ijk} = \hat{\mathbf{r}}_{ij} \cdot \hat{\mathbf{r}}_{ik}$ depends only on inner products of relative vectors: $(\mathbf{Q}\hat{\mathbf{r}}_{ij})^T (\mathbf{Q}\hat{\mathbf{r}}_{ik}) = \hat{\mathbf{r}}_{ij}^T \mathbf{Q}^T \mathbf{Q} \hat{\mathbf{r}}_{ik} = \hat{\mathbf{r}}_{ij}^T \hat{\mathbf{r}}_{ik}$.

\paragraph{Angular Degeneracy of Mean Pooling.}
Mean-angle pooling can map distinct coordination environments to similar scalar values (e.g., sp$^3$ vs.\ sp$^2$ carbons differ by only $\sim 10^\circ$). In practice, the node embedding and RBF distance channels provide sufficient disambiguation for QM9's rigid organic molecules; extending to diverse coordination chemistry (e.g., transition metal complexes) requires per-triplet angular expansion~\cite{klicperaFastUncertaintyAwareDirectional2020, klicperaGemNetUniversalDirectional2021} (see Limitation 2).

\paragraph{Entanglement Correlator Readout.}
Each head produces 8 observables from the output state $|\psi_{ij}^{(s)}\rangle$:
\begin{align}
    \text{Single-qubit:} \quad & \langle Z_q \rangle_{ij}^{(s)}, \quad q = 0, 1, 2, 3 \\
    \text{Correlators:} \quad & \langle Z_q Z_{(q+1)\bmod 4} \rangle_{ij}^{(s)}, \quad q = 0, 1, 2, 3
\end{align}

Per-head output decomposition:
\begin{align}
    \mathbf{m}_{ij}^{(s)} &= \big[\langle Z_0 \rangle, \langle Z_1 \rangle, \langle Z_2 \rangle, \nonumber \\
    &\quad \langle Z_0 Z_1 \rangle, \langle Z_1 Z_2 \rangle, \langle Z_2 Z_3 \rangle, \langle Z_3 Z_0 \rangle\big]^T \in \mathbb{R}^7 \\
    \phi_x^{(s)} &= \langle Z_3 \rangle_{ij}^{(s)} \in [-1, 1]
\end{align}
Qubit 3 is designated as the coordinate-update observable because it is maximally distant from the feature-encoding qubits (0, 1) in the ring CNOT topology, so $\phi_x^{(s)}$ carries an entanglement-processed signal rather than raw input rotations.

The two heads' messages are concatenated: $\mathbf{m}_{ij} = [\mathbf{m}_{ij}^{(1)}, \mathbf{m}_{ij}^{(2)}] \in \mathbb{R}^{14}$.

\subsection{Equivariant Message Passing}
\label{sec:message_passing}

The per-head coordinate observables $\phi_x^{(1)}, \phi_x^{(2)}$ from \S\ref{sec:quantum_edge} are combined into a single gated scalar via $\tanh$ activation, bounding each coordinate update to $(-1, 1)$:
\begin{equation}
    \phi_x(\mathbf{m}_{ij}) = \tanh\!\left(\mathbf{W}_g \left[\phi_x^{(1)}, \phi_x^{(2)}\right]^T\right) \in (-1, 1)
\end{equation}
\begin{equation}
    \mathbf{x}_i^{l+1} = \mathbf{x}_i^l + \frac{1}{|\mathcal{N}(i)|} \sum_{j \in \mathcal{N}(i)} (\mathbf{x}_i^l - \mathbf{x}_j^l) \cdot \phi_x(\mathbf{m}_{ij})
    \label{eq:coord_update}
\end{equation}

\paragraph{Invariant Feature Message Passing.}
Edge messages are aggregated per node and combined with the current features through a residual MLP update:
\begin{align}
    \mathbf{m}_i &= \sum_{j \in \mathcal{N}(i)} \mathbf{m}_{ij} \\
    \mathbf{h}_i^{l+1} &= \mathbf{h}_i^l + \mathrm{MLP}\left([\mathbf{h}_i^l, \mathbf{m}_i]\right)
    \label{eq:feat_update}
\end{align}

\subsection{Classical Dequantization: PRISM}
\label{sec:periodic_egnn}

To test whether the PQC's performance originates from quantum mechanical properties or from classical trigonometric expressivity, we construct structurally matched classical surrogates following the empirical dequantization framework~\cite{Tang:2018lmw, Schreiber:2022roq, pegg2026isoqgnn}.
Each surrogate replaces the 4-qubit PQC with a classical feedforward operator taking identical edge inputs $\mathbf{u}_{ij}^{(s)} \in \mathbb{R}^{13}$ and producing 8 bounded observable surrogates $\in [-1, 1]$.

\paragraph{Terminology Note.}
We use ``dequantization'' in the heuristic, empirical sense established by Schreiber et al.~\cite{Schreiber:2022roq} and Bowles et al.~\cite{bowles2024better}: constructing a classical model with structurally analogous hypothesis class (same parameter count, same input/output structure, analogous function-class expressivity) and demonstrating that it achieves equal or superior performance.
This is distinct from the formal complexity-theoretic dequantization of Tang~\cite{Tang:2018lmw}, which provides polynomial-time classical algorithms with provable approximation guarantees.
Our use of ``dequantization'' does not imply that the PQC studied was ever in a computationally non-classical regime.
That data re-uploading PQCs compute truncated Fourier series is a known theoretical result~\cite{Schuld:2020enb, landman2023approximating}; our contribution is the \textit{empirical demonstration} that this theoretical equivalence translates to practice when periodic sinusoidal activations are placed inside the message-passing MLPs of equivariant graph neural networks.


\paragraph{Internal Dimensionality Mismatch.}
Under strict iso-parameter matching, the 4-qubit PQC processes edge features through a $2^4 = 16$-dimensional complex Hilbert space ($\mathbb{C}^{16}$), while the classical twins operate on a 4-dimensional real hidden representation ($\mathbb{R}^4$). This biases the comparison \textit{against} the classical model in representational capacity: the PQC has access to a far larger implicit state space per evaluation. That PRISM nonetheless outperforms Q-PRISM across all electronic targets (Table~\ref{tab:main_results}) supports the empirical dequantization conclusion: the PQC's exponentially larger state space does not confer a practical advantage under local Pauli measurements, because those measurements collapse the $2^n$-dimensional state space to a polynomial number ($2n$) of real-valued expectation values $\langle Z_q \rangle, \langle Z_q Z_{q'} \rangle \in [-1,1]$.
This dimensionality collapse under local measurements is consistent with the expressivity boundaries characterized by Jerbi et al.~\cite{Jerbi:2021qnz}: when outputs are restricted to polynomial-dimensional observable spaces, the effective function class of shallow PQCs can be matched by classical models with equal parametric capacity and appropriate inductive bias.
To address this capacity asymmetry, our parameter scaling study (Section~\ref{sec:param_scaling}, Table~\ref{tab:param_scaling}) evaluates a $d_h = 16$ classical model matching the PQC's 16-dimensional Hilbert space in hidden dimension, where PRISM still outperforms the Classical Twin by $32$--$43\%$ across electronic targets, confirming that the periodic activation advantage is not an artifact of the dimensionality mismatch.

\paragraph{Classical Twin ($\tanh$-MLP).}
The standard classical twin uses a two-layer MLP with sigmoid-family activations:
\begin{equation}
    \mathbf{o}_{ij}^{(s)} = \tanh\left(\mathbf{W}_2 \operatorname{SiLU}(\mathbf{W}_1 \mathbf{u}_{ij}^{(s)} + \mathbf{b}_1)\right)
\end{equation}
where $\mathbf{W}_1 \in \mathbb{R}^{4 \times 13}$ and $\mathbf{W}_2 \in \mathbb{R}^{8 \times 4}$ (without bias). The trainable parameter budget per head is exactly $4 \times (13 + 1) + 4 \times 8 = 88$, matching the 88 parameters of the 4-qubit PQC ($24$ rotation angles $+ 64$ distance re-uploading weights) for an exact model-wide match of $2{,}527$ parameters.
\paragraph{PRISM (SIREN Periodic Twin).}
To overcome the representational limits of monotonic activations at low parameter budgets~\cite{rahaman2019spectral, sitzmann2020siren}, we replace the monotonic activation with a periodic sinusoidal non-linearity with SIREN initialization~\cite{sitzmann2020siren}:
\begin{equation}
    \mathbf{o}_{ij}^{(s)} = \tanh\left(\mathbf{W}_2 \sin\left(\omega_0 (\mathbf{W}_1 \mathbf{u}_{ij}^{(s)} + \mathbf{b}_1)\right)\right)
\end{equation}
with frequency hyperparameter $\omega_0 = 30.0$.
Following Sitzmann et al.~\cite{sitzmann2020siren}, weights are initialized as:
\begin{equation}
    \mathbf{W}_1 \sim \mathcal{U}\left(-\frac{1}{d_{\mathrm{in}}}, \frac{1}{d_{\mathrm{in}}}\right), \quad \mathbf{W}_2 \sim \mathcal{U}\left(-\frac{\sqrt{6/d_h}}{\omega_0}, \frac{\sqrt{6/d_h}}{\omega_0}\right)
\end{equation}
where $d_{\mathrm{in}} = 13$ and $d_h = 4$.
This guarantees uniform variance propagation across periodic activations, preserving oscillatory angular gradients without numerical saturation. The trainable parameter count remains identical at exactly $2{,}527$ parameters.

\paragraph{Physical Validity of Periodic Activations.}
A potential concern is whether applying periodic activations to distance-dependent features could introduce unphysical oscillatory artifacts in predicted molecular properties, particularly for geometries outside the training distribution.
We note that the sinusoidal non-linearity acts on the \textit{linearly transformed} mixed feature vector $\omega_0(\mathbf{W}_1 \mathbf{u}_{ij}^{(s)} + \mathbf{b}_1)$, not on raw interatomic distances $d_{ij}$ directly.
The learned projection $\mathbf{W}_1$ scales and combines distance, angular, and node embedding channels, while the final $\tanh$ output bounding $\in (-1, 1)$ prevents unbounded oscillatory extrapolation.
Nevertheless, for applications requiring reliable extrapolation beyond training geometries (e.g., reactive dynamics with bond-breaking events), periodic internal activations require validation against monotonic potential energy models.

\paragraph{Choice of Sinusoidal Activation.}
A natural question is why sinusoidal activations specifically, rather than other periodic or quasi-periodic alternatives such as Gaussian radial basis functions, Gabor wavelets, or sawtooth waves. Two factors favor $\sin$: (i) \textit{functional alignment with PQC outputs}: data re-uploading PQCs compute truncated Fourier series in $\sin$ and $\cos$ by construction~\cite{Schuld:2020enb}, so sinusoidal activations directly replicate the function class under test; and (ii) \textit{principled initialization and training}: SIREN~\cite{sitzmann2020siren} provides a closed-form initialization scheme guaranteeing uniform variance propagation across layers for $\sin$ activations, with no analogous result available for other periodic functions. We do not claim that $\sin$ is uniquely optimal; other periodic activations (e.g., $\cos$, Gabor filters) may perform comparably on molecular prediction tasks. However, our dequantization argument specifically requires functional alignment with PQC outputs, which favors the Fourier basis.

\paragraph{Fourier Feature Twin (RFF).}
As an alternative baseline, we implement Random Fourier Features (RFF) following Tancik et al.~\cite{tancik2020fourier}:
$\gamma(\mathbf{u}) = [\cos(2\pi \mathbf{B}\mathbf{u}), \sin(2\pi \mathbf{B}\mathbf{u})]^T$, where $\mathbf{B} \in \mathbb{R}^{13 \times 4}$ is a fixed Gaussian random matrix ($\sigma = 10.0$), followed by a linear projection matching $2{,}515$ parameters ($\Delta = -12$).

Because all inputs $\mathbf{u}_{ij}^{(s)}$ are strictly $\mathrm{O}(3)$-invariant, Theorem~\ref{thm:equivariance} applies identically to PRISM, Classical Twin ($\tanh$), and Fourier Feature twins, guaranteeing exact machine-precision $\mathrm{E}(3)$ equivariance for all classical variants.

