\subsection{Theoretical Guarantees and Pseudocode}
\label{sec:theory}

\begin{theorem}[$\mathrm{E}(3)$ Equivariance of Q-PRISM Layer]
\label{thm:equivariance}
Let $\mathcal{T}_{\mathbf{Q}, \mathbf{g}}(\mathbf{x}) = \mathbf{x} \mathbf{Q}^T + \mathbf{g}$ denote an arbitrary continuous Euclidean transformation with rotation/reflection $\mathbf{Q} \in \mathrm{O}(3)$ and translation $\mathbf{g} \in \mathbb{R}^3$.\footnote{We adopt a row-vector convention throughout: coordinates are stored as $\mathbf{x}_i \in \mathbb{R}^{1 \times 3}$ (row vectors), so the transformation is $\mathbf{x} \mathbf{Q}^T + \mathbf{g}$ rather than $\mathbf{Q}\mathbf{x} + \mathbf{g}$. This matches PyTorch's default batch-of-row-vectors layout.} Then for the Q-PRISM layer defined in Eqs.~(\ref{eq:coord_update}--\ref{eq:feat_update}):
\begin{align}
    \mathbf{h}_i^{l+1}(\mathcal{T}_{\mathbf{Q}, \mathbf{g}}(\mathbf{x}), \mathbf{h}) &= \mathbf{h}_i^{l+1}(\mathbf{x}, \mathbf{h}) \quad (\text{Invariance}) \\
    \mathbf{x}_i^{l+1}(\mathcal{T}_{\mathbf{Q}, \mathbf{g}}(\mathbf{x}), \mathbf{h}) &= \mathcal{T}_{\mathbf{Q}, \mathbf{g}}(\mathbf{x}_i^{l+1}(\mathbf{x}, \mathbf{h})) \quad (\text{Equivariance})
\end{align}
\end{theorem}

\begin{proof}
Under transformation $\mathcal{T}_{\mathbf{Q}, \mathbf{g}}$, the relative coordinate vector transforms as $\mathbf{r}_{ij}' = \mathbf{r}_{ij}\mathbf{Q}^T$, yielding invariant squared distance $d_{ij}' = d_{ij}$.

The RBF features $\phi_k(d_{ij})$ are functions of the invariant $d_{ij}$ and thus invariant. The 3-body angles $\bar{\theta}_{ij}$ depend only on inner products of unit vectors (Eq.~\ref{eq:angle}), which satisfy $(\mathbf{Q}\hat{\mathbf{r}}_{ij}) \cdot (\mathbf{Q}\hat{\mathbf{r}}_{ik}) = \hat{\mathbf{r}}_{ij} \cdot \hat{\mathbf{r}}_{ik}$ by orthogonality of $\mathbf{Q}$. Since all PQC inputs $\mathbf{u}_{ij}^{(s)}$ are invariant, the quantum state $|\psi_{ij}^{(s)}\rangle$ and all observables ($\mathbf{m}_{ij}$, $\phi_x$) are invariant. The $\tanh$ gating function is a scalar function of invariant inputs and thus invariant.

Substituting into the coordinate update:
\begin{align}
    \mathbf{x}_i^{l+1}(\mathbf{x}', \mathbf{h}) &= \mathbf{x}_i' + \frac{1}{|\mathcal{N}(i)|} \sum_{j} \mathbf{r}_{ij}' \cdot \phi_x(\mathbf{m}_{ij}) \nonumber \\
    &= (\mathbf{x}_i \mathbf{Q}^T + \mathbf{g}) + \left[\frac{1}{|\mathcal{N}(i)|} \sum_{j} \mathbf{r}_{ij} \phi_x(\mathbf{m}_{ij})\right] \mathbf{Q}^T \nonumber \\
    &= \mathcal{T}_{\mathbf{Q}, \mathbf{g}}(\mathbf{x}_i^{l+1}(\mathbf{x}, \mathbf{h}))
\end{align}
Node features depend solely on invariant quantities, proving exact feature invariance.\footnote{Our $\mathrm{E}(3)$ equivariance construction treats all vector quantities as polar vectors. For properties that transform as pseudovectors under improper rotations (e.g., magnetic moments, angular momentum), the model would require parity-aware equivariant channels~\cite{batatiaMACEHigherOrder2022}. All QM9 targets studied here are scalar invariants and thus unaffected by this limitation.}
\end{proof}

\paragraph{Empirical Verification.}
Numerical testing with random $\mathrm{O}(3)$ rotations confirms equivariance errors $\le 2.38 \times 10^{-7}$ (SM~A).

\paragraph{Algorithm Pseudocode.}
\label{sec:pseudocode}
Algorithm~\ref{alg:prism} provides pseudocode for the PRISM (classical) forward pass. The Q-PRISM variant replaces line~\ref{alg:prism_edge} with PQC evaluation (Algorithm~\ref{alg:qprism_edge}).

\begin{algorithm}[t]
\caption{PRISM Forward Pass (Single Layer)}
\label{alg:prism}
\begin{algorithmic}[1]
\REQUIRE Molecular graph $\mathcal{G} = (\mathcal{V}, \mathcal{E}, \mathbf{x}, \mathbf{h})$
\REQUIRE SIREN parameters $\mathbf{W}_1, \mathbf{b}_1, \mathbf{W}_2$ per head $s \in \{1,2\}$
\REQUIRE Frequency scale $\omega_0 = 30.0$
\FOR{each edge $(i, j) \in \mathcal{E}$}
    \STATE $d_{ij} \leftarrow \|\mathbf{x}_i - \mathbf{x}_j\|^2$ \COMMENT{Invariant distance}
    \STATE $\boldsymbol{\phi}(d_{ij}) \leftarrow [\exp(-\gamma_k(d_{ij} - \mu_k)^2)]_{k=1}^K$ \COMMENT{RBF}
    \STATE $\bar{\theta}_{ij} \leftarrow \text{MeanAngle}(i, j, \mathcal{N}(i))$ \COMMENT{Eq.~\ref{eq:angle}}
    \FOR{each head $s \in \{1, 2\}$}
        \STATE $\mathbf{h}_i^{p} \leftarrow \mathbf{W}_p^{(s)} \mathbf{h}_i$ \COMMENT{Project to 2D}
        \STATE $\mathbf{u}_{ij}^{(s)} \leftarrow [\mathbf{h}_i^p, \mathbf{h}_j^p, \boldsymbol{\phi}(d_{ij}), \bar{\theta}_{ij}]$ \COMMENT{$\in \mathbb{R}^{13}$}
        \STATE $\mathbf{o}_{ij}^{(s)} \leftarrow \tanh(\mathbf{W}_2 \sin(\omega_0(\mathbf{W}_1 \mathbf{u}_{ij}^{(s)} + \mathbf{b}_1)))$ \label{alg:prism_edge} \COMMENT{SIREN}
    \ENDFOR
    \STATE $\mathbf{m}_{ij} \leftarrow [[\mathbf{o}_{ij}^{(1)}]_{1:7},\; [\mathbf{o}_{ij}^{(2)}]_{1:7}]$ \COMMENT{Message $\in \mathbb{R}^{14}$}
    \STATE $\phi_x \leftarrow \tanh(\mathbf{W}_g [[\mathbf{o}_{ij}^{(1)}]_8, [\mathbf{o}_{ij}^{(2)}]_8])$ \COMMENT{Coord. scalar}
\ENDFOR
\FOR{each node $i \in \mathcal{V}$}
    \STATE $\mathbf{x}_i \leftarrow \mathbf{x}_i + \frac{1}{|\mathcal{N}(i)|}\sum_{j} (\mathbf{x}_i - \mathbf{x}_j) \cdot \phi_x(\mathbf{m}_{ij})$
    \STATE $\mathbf{h}_i \leftarrow \mathbf{h}_i + \text{MLP}([\mathbf{h}_i,\; \sum_j \mathbf{m}_{ij}])$
\ENDFOR
\RETURN $\mathbf{x}, \mathbf{h}$
\end{algorithmic}
\end{algorithm}

\begin{algorithm}[t]
\caption{Q-PRISM Edge Operator (replaces Algorithm~\ref{alg:prism} line~\ref{alg:prism_edge})}
\label{alg:qprism_edge}
\begin{algorithmic}[1]
\REQUIRE Edge input $\mathbf{u}_{ij}^{(s)} \in \mathbb{R}^{13}$, PQC parameters $\boldsymbol{\Theta}$
\STATE $|\psi\rangle \leftarrow |0\rangle^{\otimes 4}$
\FOR{$l = 1$ to $L$}
    \STATE $|\psi\rangle \leftarrow U_{\mathrm{feat}}(\mathbf{h}_i^p, \mathbf{h}_j^p)\,|\psi\rangle$ \COMMENT{$R_Y$ encoding}
    \STATE $|\psi\rangle \leftarrow U_{\mathrm{dist}}^{(l)}(\boldsymbol{\phi}(d_{ij}))\,|\psi\rangle$ \COMMENT{$R_Z$ distance}
    \STATE $|\psi\rangle \leftarrow U_{\mathrm{ang}}(\bar{\theta}_{ij})\,|\psi\rangle$ \COMMENT{$R_Y$ angular}
    \STATE $|\psi\rangle \leftarrow U_{\mathrm{rot}}(\boldsymbol{\theta}_l)\,|\psi\rangle$ \COMMENT{$R_x R_y R_z$ variational}
    \STATE $|\psi\rangle \leftarrow U_{\mathrm{ent}}\,|\psi\rangle$ \COMMENT{Ring CNOT}
\ENDFOR
\STATE $\mathbf{o}_{ij}^{(s)} \leftarrow [\langle Z_q \rangle,\; \langle Z_q Z_{q+1} \rangle]_{q=0}^3$ \COMMENT{8 observables}
\RETURN $\mathbf{o}_{ij}^{(s)} \in [-1, 1]^8$
\end{algorithmic}
\end{algorithm}

\section{Experimental Evaluation}
\label{sec:experiments}

\subsection{Benchmark Setup}

We benchmark Q-PRISM on the standard \textbf{QM9 dataset} \cite{ramakrishnan2014quantum}, containing $130{,}831$ small organic molecules with quantum electronic properties computed at the B3LYP/6-31G(2df,p) level of DFT.
We evaluate across \textbf{6 physical targets} using \textbf{5 independent random seeds} ($42$--$46$) on $N = 1{,}000$ training molecules and $500$ test molecules.
We select targets that span three distinct physical mechanisms: intensive electronic properties (HOMO, LUMO, Gap), which probe angular orbital overlaps central to our spectral bias hypothesis; extensive electrostatic properties (dipole moment $\mu$, polarizability $\alpha$), which test coordinate-dependent charge distribution; and extensive thermodynamic energy ($U_0$). We note that KS-DFT LUMO energies, unlike HOMO energies (which approximate ionization potentials via the Kohn-Sham analog of Koopmans' theorem), lack strict physical interpretation and are highly basis-set dependent; LUMO results should be interpreted with this caveat. The remaining QM9 properties ($U$, $H$, and $G$) derive linearly from $U_0$ through thermal and entropic corrections, making separate comparisons redundant. Vibrational properties ($\text{ZPVE}$ and $C_v$) fall outside the capacity of compact $\sim 2{,}500$-parameter models.
The $1{,}000 / 500$ split (a 2:1 ratio) represents a standard protocol for low-data chemical benchmarking, providing sufficient statistical power for paired comparisons while maintaining simulation tractability across 8 models and multi-seed sweeps.
Complete training hyperparameters (optimizer, learning rate, scheduler, batch size, early stopping, and computational resources) are provided in SM~A, Table~S1.

\paragraph{Random Seed Protocol.}
All random seeds ($42$--$46$ for 5-seed experiments; $42$--$61$ for 20-seed ablations) control both model parameter initialization and the train/test data split. That is, each seed produces a different random partition of QM9 molecules into training and test sets, as well as a different random initialization of all trainable weights. The reported variance across seeds therefore captures both optimizer sensitivity and data-split variability, providing a more conservative estimate of model reliability than initialization-only variance. We note that this protocol measures combined init-and-split variance rather than pure generalization variance via K-fold cross-validation. A factorial design (fixing one factor while varying the other) or stratified K-fold cross-validation would enable formal variance decomposition; we acknowledge this as a methodological limitation. However, the large effect sizes observed (Cohen's $d > 0.85$ for the key comparisons) and the consistency across 20 seeds provide strong evidence that the results are not artifacts of a single favorable split.
We acknowledge that with $n = 5$ seeds, the normality assumption underlying parametric paired $t$-tests cannot be rigorously verified. Key comparisons are therefore confirmed by the 20-seed ablation (Section~\ref{sec:mechanism}), where normality is more plausible, and by non-parametric Wilcoxon signed-rank tests that yield consistent conclusions across all significant comparisons.
We note, however, that the minimum achievable two-sided Wilcoxon $p$-value at $n = 5$ is $p = 2/2^5 = 0.0625$ (requiring all 5 paired differences to be in the same direction), so this test is inherently underpowered at this sample size and cannot reach conventional significance ($\alpha = 0.05$). The 20-seed ablation provides adequate power for rank-based tests.
Post-hoc power analysis indicates that the 5-seed design ($n = 5$, paired) is powered to detect effect sizes of Cohen's $d \ge 1.53$ at $\alpha = 0.05$ and $1-\beta = 0.80$, corresponding to very large effects only. The 20-seed ablation ($n = 20$) is powered to detect $d \ge 0.66$ (medium-large effects), consistent with the observed $d = 0.85$ for the HOMO entanglement comparison.

\paragraph{Extended Baseline Hierarchy (8 Models).}
To isolate the contribution of the quantum circuit from the classical feature engineering pipeline, we evaluate across an 8-model hierarchy:
\begin{itemize}
    \item \textbf{Tier 1 (Iso-Architecture Classical \& Trigonometric Twins, $\sim 2{,}527$ params):} 
    (i) \textit{Classical Twin ($\tanh$-MLP)} ($2{,}527$ p): Replaces the PQC with a standard $\text{SiLU} \to \text{Linear} \to \tanh$ MLP matching exactly 88 parameters per head.
    (ii) \textit{PRISM (SIREN)} ($2{,}527$ p): Replaces the PQC with a periodic sinusoidal activation ($\sin(\omega_0 W x + b)$) with SIREN initialization~\cite{sitzmann2020siren}, maintaining exact parameter parity.
    (iii) \textit{Fourier Feature Twin (RFF)} ($2{,}515$ p): Maps inputs through static random Fourier features~\cite{tancik2020fourier} before linear readout.
    \item \textbf{Tier 2 (SOTA Equivariant Baselines):} Parameter-matched implementations of SchNet~\cite{schütt2017schnetcontinuousfilterconvolutionalneural} ($2{,}473$ params) and PaiNN~\cite{schuttEquivariantMessagePassing2021} ($2{,}721$ params), representing established classical continuous-filter and directional equivariant architectures.
    \item \textbf{Tier 3 (Iso-Parameter \& Standard EGNN):} Parameter-matched EGNN~\cite{satorras2022enequivariantgraphneural} ($2{,}497$ params) and standard EGNN ($4{,}289$ params, $\texttt{hidden}=16$).
    \item \textbf{Tier 4 (Symmetry Control):} Non-equivariant GNN with raw Cartesian concatenation, verifying that continuous $\mathrm{E}(3)$ symmetry is physically necessary.
\end{itemize}

