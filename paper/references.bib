@article{klicperaGemNetUniversalDirectional2021,
  title = {{{GemNet}}: {{Universal Directional Graph Neural Networks}} for {{Molecules}}},
  author = {Klicpera, Johannes and Becker, Florian and Gunnemann, Stephan},
