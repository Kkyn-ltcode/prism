}

@article{Lin:2020myx,
  title = {Variational {{Embedding}} for {{Quantum Many}}‐{{Body Problems}}},
  author = {Lin, Lin and Lindsey, Michael},
  date = {2022-09},
  journaltitle = {Communications on Pure and Applied Mathematics},
  shortjournal = {Comm Pure Appl Math},
  volume = {75},
